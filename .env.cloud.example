# Cloud Run runtime environment (demo only)
NODE_ENV=production
DEPLOYMENT_MODE=CLOUD
PORT=8080
DATA_DIR=/tmp/medikiosk-data

# Set this to the exact Vercel production origin. Add additional trusted origins
# as comma-separated values; do not use a wildcard.
ALLOWED_ORIGINS=https://your-project.vercel.app
CROSS_SITE_COOKIES=true
SESSION_COOKIE_SECURE=true

# Configure as a Secret Manager secret in Cloud Run, not in source control.
GEMINI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Leave DATABASE_URL unset for the disposable JSON demo.
# Cloud Run's local filesystem is ephemeral; this is not durable persistence.

# Optional local-only speech/OCR services are not included in the Cloud Run image.
# SPEECH_SERVICE_URL=
# OCR_SERVICE_URL=
