# MediKiosk AI Provider Configuration
# Supported: groq | gemini | ollama
AI_PROVIDER=groq

# Groq Configuration (Ultra-fast LLM inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MediKiosk Local Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
CONVERSATION_MODEL=qwen2.5:7b
MEDICAL_MODEL=medgemma1.5:latest
AI_TIMEOUT=120000

# MediKiosk Local Faster-Whisper Speech Service Configuration
SPEECH_SERVICE_URL=http://127.0.0.1:8001
MAX_AUDIO_SIZE_MB=25

# Python Speech Service Model Settings
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# MediKiosk Local PaddleOCR Document Service Configuration
OCR_SERVICE_URL=http://127.0.0.1:8002
MAX_DOCUMENT_SIZE_MB=20
MAX_PDF_PAGES=20
OCR_MIN_CONFIDENCE=0.70

# Python OCR Service Model Settings
OCR_LANG=en
OCR_DEVICE=auto

NODE_ENV=development
PORT=3000
