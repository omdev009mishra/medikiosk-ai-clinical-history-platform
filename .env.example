# =======================================================
# MediKiosk Production Hybrid Deployment Configuration
# =======================================================

# Deployment Mode: LOCAL_HOSPITAL (Inside Hospital LAN) | CLOUD (Central AWS)
DEPLOYMENT_MODE=LOCAL_HOSPITAL
NODE_ENV=production
PORT=3000

# =======================================================
# 1. Database Configuration (PostgreSQL)
# =======================================================
# Local Hospital: postgresql://medikiosk:medikiosk_local_secret@postgres:5432/medikiosk_db
# Cloud AWS RDS: postgresql://dbuser:dbpass@medikiosk-rds.ap-south-1.rds.amazonaws.com:5432/medikiosk_prod
DATABASE_URL=postgresql://medikiosk:medikiosk_local_secret@localhost:5432/medikiosk_db

# =======================================================
# 2. Security & Authentication
# =======================================================
JWT_SECRET=your_long_secure_jwt_secret_here_min_32_chars
SESSION_COOKIE_SECURE=true

# =======================================================
# 3. Cloud Synchronization (Local-First Sync Engine)
# =======================================================
CLOUD_API_URL=https://api.medikiosk.in
CLOUD_SYNC_SECRET=your_hospital_to_cloud_sync_token

# =======================================================
# 4. AWS Mumbai (ap-south-1) & Object Storage
# =======================================================
AWS_REGION=ap-south-1
S3_BUCKET=medikiosk-clinical-records-2026

# Note: In AWS cloud deployment (EC2/ECS), credentials are automatically
# resolved via the standard AWS credential chain (EC2 IAM Role / Task Role).
# Static access keys are NOT required or recommended for production.
# Optional for local S3 development only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =======================================================
# 5. AI Services Configuration
# =======================================================
# Supported: gemini | groq | ollama
AI_PROVIDER=gemini

# Google Gemini Live API (Full-Duplex Native Audio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq (Optional fast text inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama AI (Fallback offline LLM)
OLLAMA_BASE_URL=http://localhost:11434
CONVERSATION_MODEL=qwen2.5:7b
MEDICAL_MODEL=medgemma1.5:latest
AI_TIMEOUT=120000

# =======================================================
# 6. Faster-Whisper Local Speech Service (Internal Port 8001)
# =======================================================
SPEECH_SERVICE_URL=http://127.0.0.1:8001
MAX_AUDIO_SIZE_MB=25
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# =======================================================
# 7. PaddleOCR Local Document Service (Internal Port 8002)
# =======================================================
OCR_SERVICE_URL=http://127.0.0.1:8002
MAX_DOCUMENT_SIZE_MB=20
MAX_PDF_PAGES=20
OCR_MIN_CONFIDENCE=0.70
OCR_LANG=en
OCR_DEVICE=auto

# =======================================================
# 8. Monitoring & Observability
# =======================================================
SENTRY_DSN=
